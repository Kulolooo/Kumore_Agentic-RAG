# 复制为 .env 后按需修改（.env 已被 .gitignore 排除）
#
# 语料目录：指向你自己的文档目录（PDF/DOCX/PPTX/XLSX/MD/TXT）。
KUMORE_CORPUS_ROOT=./data/corpus

# DeepSeek：不填也能跑 `search` 和 `eval --offline`，只是无法生成回答。
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# 检索与分块（默认值即可，改之前先跑一遍基线）
KUMORE_CHUNK_SIZE=800
KUMORE_CHUNK_OVERLAP=150
KUMORE_TOP_K=5
KUMORE_RETRIEVE_CUTOFF=0.0

# 解析：native 后端完全离线；unstructured 需要 spaCy 模型。
KUMORE_PARSER=native
KUMORE_PARSE_STRATEGY=fast
KUMORE_MAX_FILE_MB=300

# OCR：扫描 PDF 的低文字层页、独立图片（PNG/JPG/WebP/BMP/TIFF）走 RapidOCR。
# auto=只 OCR 文字过少的页；always=每页都 OCR（慢/可能重复）；off=关闭。
KUMORE_OCR_MODE=auto
KUMORE_OCR_DPI=150
KUMORE_OCR_MIN_CHARS=20
# 单页长边上限；内存紧张时调小，识别率会下降。
KUMORE_OCR_MAX_SIDE=1400
# 每 OCR 多少页重建一次 ONNX session（0=不主动重建）；用于避免长 PDF bad allocation。
KUMORE_OCR_RESET_EVERY=4
KUMORE_OCR_THREADS=4

# 隐私：是否把文档标题/相对路径一起发给模型。默认 0（不发）。
# 注意：片段正文仍会随请求发送，见 README「数据流向」。
KUMORE_SEND_PATHS=0

# 响应缓存：开启后同一请求逐字一致（也省钱），默认关闭以免掩盖模型方差。
KUMORE_LLM_CACHE=0

# 同一"版本族"最多占几个 top-k 名额（0 = 不限）
KUMORE_MAX_PER_FAMILY=3

# ---- M0-1：本地 embedding（索引侧不出网）----
# 检索模式：bm25（M0 基线）/ vector / hybrid
KUMORE_RETRIEVAL_MODE=bm25
# 混合检索的融合方式：rrf（免调参）/ weighted（RAGFlow 主链的加权和）
KUMORE_FUSION=rrf
KUMORE_VECTOR_WEIGHT=0.3
KUMORE_RRF_K=60
# 本地 embedding 模型与设备。bge-visualized-m3 = bge-m3 文本塔 + EVA-CLIP 视觉塔：
# 文本检索行为与 bge-m3 一致，额外给了图片入库的通路。视觉权重 1.75 GB，
# 首次使用先下载（文本塔权重仍按 KUMORE_ALLOW_MODEL_DOWNLOAD=1 走 HF 缓存）：
#   curl -L -o storage/models/visual/Visualized_m3.pth \
#     https://hf-mirror.com/BAAI/bge-visualized/resolve/main/Visualized_m3.pth
# 双塔：文本 bge-m3；视觉 bge-visualized 只编码图片/页面图。
KUMORE_EMBED_MODEL=BAAI/bge-m3
KUMORE_VISUAL_EMBED_MODEL=BAAI/bge-visualized-m3
KUMORE_EMBED_DEVICE=cpu
KUMORE_EMBED_BATCH=32
# Windows 上 torch.load(mmap=True) 加载 1.75GB 视觉权重曾 access violation；
# 视觉模型建议用 0（多占一份内存，但更稳）。
KUMORE_VISUAL_MMAP=0
# 每库可覆盖检索模式：python -m app kb mode <id> hybrid
# 不设则沿用上面的 KUMORE_RETRIEVAL_MODE。
# 视觉权重路径（默认 storage/models/visual/Visualized_m3.pth）
# KUMORE_EMBED_VISUAL_WEIGHT=./storage/models/visual/Visualized_m3.pth
# 模型权重缓存目录（默认 storage/models，已被 gitignore）
# KUMORE_MODEL_DIR=./storage/models

# ---- M2：重排（默认关闭）----
# M2 实测：bge-reranker-base 在 CPU 上 20 对约 8 s；且它的 514 token 上限截断了
# 本语料 67% 的候选对，所以"净损失"只对这套模型 + 截断成立。长上下文模型需重测。
# 首次使用需先下载权重：python tools/m2_matrix.py --groups A --download-reranker
# KUMORE_RERANK=0
# KUMORE_RERANK_MODEL=BAAI/bge-reranker-base
# KUMORE_RERANK_CANDIDATES=20
# KUMORE_RERANK_DEVICE=cpu
# KUMORE_RERANK_FAIL_OPEN=1
# 元数据过滤在命令行传：--ext .docx --path-prefix 竞赛/ --since 2026-01-01
